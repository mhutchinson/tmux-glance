#!/usr/bin/env bash
set -euo pipefail

# Configurable agent command pattern (supports work override via env var)
AGENT_COMMANDS_PATTERN="${TMUX_AGENT_COMMANDS:-^(agy|antigravity)$}"

bookmarks_file="$HOME/.tmux-bookmarks"
touch "$bookmarks_file"

# Atomic lock helpers
acquire_lock() {
    local lock_dir="${bookmarks_file}.lock"
    local count=0
    while ! mkdir "$lock_dir" 2>/dev/null; do
        sleep 0.02
        count=$((count + 1))
        if [[ $count -ge 50 ]]; then
            # Break stale lock if held longer than 1 second
            rmdir "$lock_dir" 2>/dev/null || true
            count=0
        fi
    done
}

release_lock() {
    local lock_dir="${bookmarks_file}.lock"
    rmdir "$lock_dir" 2>/dev/null || true
}

with_lock() {
    acquire_lock
    local ret=0
    "$@" || ret=$?
    release_lock
    return $ret
}

# Prune dead panes from bookmarks
prune_bookmarks() {
    # Guard: if tmux is not running or unreachable, do not prune (prevents wiping bookmarks)
    tmux info &>/dev/null || return 0

    local alive_panes
    alive_panes=$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)
    [[ -z "$alive_panes" ]] && return 0

    local temp_file pane_id session_name window_index pane_index path command label kind state
    temp_file=$(mktemp)
    while IFS=$'\t' read -r pane_id session_name window_index pane_index path command label kind state || [[ -n "$pane_id" ]]; do
        [[ -z "$pane_id" ]] && continue
        kind="${kind:-manual}"
        state="${state:-pinned}"
        if [[ " $alive_panes " =~ " $pane_id " ]]; then
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                "$pane_id" "$session_name" "$window_index" "$pane_index" "$path" "$command" "$label" "$kind" "$state" >> "$temp_file"
        fi
    done < "$bookmarks_file"
    mv "$temp_file" "$bookmarks_file"
}

# Add a manual bookmark (pinned)
add_bookmark() {
    local label="$1"
    local info pane_id session_name window_index pane_index path command
    
    prune_bookmarks

    info=$(tmux display-message -p '#{pane_id}	#{session_name}	#{window_index}	#{pane_index}	#{pane_current_path}	#{pane_current_command}')
    IFS=$'\t' read -r pane_id session_name window_index pane_index path command <<< "$info"

    if [[ -z "$label" ]]; then
        label="$command in $(basename "$path")"
    fi

    local temp_file
    temp_file=$(mktemp)
    if [[ -f "$bookmarks_file" ]]; then
        grep -v "^${pane_id}	" "$bookmarks_file" > "$temp_file" 2>/dev/null || true
    fi

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\tmanual\tpinned\n" \
        "$pane_id" "$session_name" "$window_index" "$pane_index" "$path" "$command" "$label" >> "$temp_file"
    mv "$temp_file" "$bookmarks_file"
    tmux display-message "📌 Pinned: $label"
}

# Remove a bookmark manually
remove_bookmark() {
    prune_bookmarks

    local pane_id stored_label
    pane_id=$(tmux display-message -p '#{pane_id}')

    if grep -q "^${pane_id}	" "$bookmarks_file" 2>/dev/null; then
        stored_label=$(grep "^${pane_id}	" "$bookmarks_file" | cut -f7)
        local temp_file
        temp_file=$(mktemp)
        grep -v "^${pane_id}	" "$bookmarks_file" > "$temp_file" 2>/dev/null || true
        mv "$temp_file" "$bookmarks_file"
        tmux display-message "📌 Unpinned: $stored_label"
    else
        tmux display-message "Not pinned."
    fi
}

is_pinned() {
    local pane_id
    pane_id=$(tmux display-message -p '#{pane_id}')
    grep -q "^${pane_id}	" "$bookmarks_file" 2>/dev/null
}

# Return list of currently focused pane IDs across all attached clients
get_focused_panes() {
    tmux list-clients -F '#{pane_id}' 2>/dev/null || true
}

# Scan agent panes across tmux and update background agent watch states
scan_agents() {
    prune_bookmarks

    local focused_panes
    focused_panes=$(get_focused_panes | tr '\n' ' ')

    # Read existing bookmarks into associative state lookups
    declare -A bm_kind bm_state bm_label
    local p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st
    while IFS=$'\t' read -r p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st || [[ -n "$p_id" ]]; do
        [[ -z "$p_id" ]] && continue
        bm_kind["$p_id"]="${p_k:-manual}"
        bm_state["$p_id"]="${p_st:-pinned}"
        bm_label["$p_id"]="${p_lbl}"
    done < "$bookmarks_file"

    local updated=0
    local panes_list
    panes_list=$(tmux list-panes -a -F '#{pane_id}|#{session_name}|#{window_index}|#{pane_index}|#{pane_current_path}|#{pane_current_command}|#{pane_tty}' 2>/dev/null || true)

    declare -A curr_sess curr_win curr_pane curr_path curr_cmd
    # Process all panes running matched agent commands
    while IFS='|' read -r pane_id sess win pane path cmd tty; do
        [[ -z "$pane_id" ]] && continue

        curr_sess["$pane_id"]="$sess"
        curr_win["$pane_id"]="$win"
        curr_pane["$pane_id"]="$pane"
        curr_path["$pane_id"]="$path"
        curr_cmd["$pane_id"]="$cmd"

        # Manual bookmarks are never touched by auto-agent tracking
        if [[ "${bm_kind[$pane_id]:-}" == "manual" ]]; then
            continue
        fi

        local is_focused=0
        if [[ " $focused_panes " =~ " $pane_id " ]]; then
            is_focused=1
        fi

        if [[ "$cmd" =~ $AGENT_COMMANDS_PATTERN ]]; then
            local tail_text
            tail_text=$(tmux capture-pane -p -t "$pane_id" 2>/dev/null | tail -n 4)

            local current_state="${bm_state[$pane_id]:-}"
            local new_state=""
            local new_label=""

            # Classify state based on strict footer cues (pure bash regex for speed)
            if [[ "$tail_text" =~ (Requesting[[:space:]]permission[[:space:]]for|Run[[:space:]]this[[:space:]]command\?|Navigate[[:space:]]·[[:space:]]tab[[:space:]]Amend|1\.[[:space:]]Yes,[[:space:]]run[[:space:]]command|\(y/n\)) ]]; then
                new_state="waiting"
                new_label="waiting for confirmation"
            elif [[ "$tail_text" =~ "esc to cancel" ]]; then
                new_state="running"
                new_label="running"
            elif [[ "$tail_text" =~ "\? for shortcuts" ]]; then
                # Only maintain/transition to done if it was previously tracked
                if [[ "$current_state" == "running" || "$current_state" == "waiting" || "$current_state" == "done" ]]; then
                    new_state="done"
                    new_label="finished"
                fi
            fi

            # If currently focused by the user:
            # - If not already tracked, do NOT add to watch list (background agents only)
            # - If already tracked and done, clear immediately
            if [[ $is_focused -eq 1 ]]; then
                if [[ -z "$current_state" ]]; then
                    continue
                fi
                if [[ "$new_state" == "done" || "$current_state" == "done" ]]; then
                    unset "bm_kind[$pane_id]"
                    unset "bm_state[$pane_id]"
                    unset "bm_label[$pane_id]"
                    updated=1
                    continue
                fi
            fi

            # Background pane doing something: add or update
            if [[ -n "$new_state" ]]; then
                if [[ "$current_state" != "$new_state" ]]; then
                    bm_kind["$pane_id"]="auto"
                    bm_state["$pane_id"]="$new_state"
                    bm_label["$pane_id"]="$new_label in $(basename "$path")"
                    updated=1
                fi
            fi
        else
            # Command changed away from agent (e.g. running a tool or exited to zsh)
            local current_state="${bm_state[$pane_id]:-}"
            if [[ -n "$current_state" && ("$current_state" == "running" || "$current_state" == "waiting") ]]; then
                # Check if agent process is still running on this pane's TTY (spawning tool command)
                local tty_name="${tty#/dev/}"
                if [[ -n "$tty_name" ]] && ps -t "$tty_name" -o comm= 2>/dev/null | grep -qE "$AGENT_COMMANDS_PATTERN"; then
                    # Agent process still alive; keep running
                    :
                else
                    # Agent process has terminated back to shell
                    bm_state["$pane_id"]="done"
                    bm_label["$pane_id"]="exited in $(basename "$path")"
                    updated=1
                fi
            fi
        fi
    done <<< "$panes_list"

    # Write back if state changed
    if [[ $updated -eq 1 ]]; then
        local temp_file
        temp_file=$(mktemp)
        # Re-read existing file to preserve structure and rewrite updated entries
        while IFS=$'\t' read -r p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st || [[ -n "$p_id" ]]; do
            [[ -z "$p_id" ]] && continue
            # Refresh session and window metadata if available
            s_name="${curr_sess[$p_id]:-$s_name}"
            w_idx="${curr_win[$p_id]:-$w_idx}"
            p_idx="${curr_pane[$p_id]:-$p_idx}"
            p_path="${curr_path[$p_id]:-$p_path}"
            p_cmd="${curr_cmd[$p_id]:-$p_cmd}"

            if [[ -n "${bm_kind[$p_id]:-}" ]]; then
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                    "$p_id" "$s_name" "$w_idx" "$p_idx" "$p_path" "$p_cmd" "${bm_label[$p_id]}" "${bm_kind[$p_id]}" "${bm_state[$p_id]}" >> "$temp_file"
                unset "bm_kind[$p_id]"
            fi
        done < "$bookmarks_file"

        # Append newly created auto bookmarks
        for p_id in "${!bm_kind[@]}"; do
            local s_n="${curr_sess[$p_id]:-}"
            local w_i="${curr_win[$p_id]:-}"
            local p_i="${curr_pane[$p_id]:-}"
            local p_p="${curr_path[$p_id]:-}"
            local p_c="${curr_cmd[$p_id]:-}"
            if [[ -n "$s_n" ]]; then
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                    "$p_id" "$s_n" "$w_i" "$p_i" "$p_p" "$p_c" "${bm_label[$p_id]}" "${bm_kind[$p_id]}" "${bm_state[$p_id]}" >> "$temp_file"
            fi
        done

        mv "$temp_file" "$bookmarks_file"
    fi
}

# Called when focus changes to a pane
on_focus() {
    local target_pane="${1:-}"
    if [[ -z "$target_pane" ]]; then
        target_pane=$(tmux display-message -p '#{pane_id}')
    fi

    [[ -z "$target_pane" ]] && return 0

    if grep -q "^${target_pane}	" "$bookmarks_file" 2>/dev/null; then
        local entry kind state
        entry=$(grep "^${target_pane}	" "$bookmarks_file" | head -n 1)
        kind=$(echo "$entry" | awk -F'\t' '{print $8}')
        state=$(echo "$entry" | awk -F'\t' '{print $9}')

        # If it is an auto-agent bookmark and it has finished, clear it on focus
        if [[ "$kind" == "auto" && "$state" == "done" ]]; then
            local temp_file
            temp_file=$(mktemp)
            grep -v "^${target_pane}	" "$bookmarks_file" > "$temp_file" 2>/dev/null || true
            mv "$temp_file" "$bookmarks_file"
            tmux refresh-client -S 2>/dev/null || true
        fi
    fi
}

# Output formatted string for tmux status-right
status_summary() {
    scan_agents

    local waiting_count=0
    local running_count=0
    local done_count=0

    while IFS=$'\t' read -r p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st || [[ -n "$p_id" ]]; do
        [[ -z "$p_id" ]] && continue
        if [[ "$p_k" == "auto" ]]; then
            case "$p_st" in
                waiting) waiting_count=$((waiting_count + 1)) ;;
                running) running_count=$((running_count + 1)) ;;
                done)    done_count=$((done_count + 1)) ;;
            esac
        fi
    done < "$bookmarks_file"

    local out=""
    if [[ $waiting_count -gt 0 ]]; then
        out="${out}#[fg=#fab387,bold]🤖 ⏳ ${waiting_count}#[default] "
    fi
    if [[ $running_count -gt 0 ]]; then
        out="${out}#[fg=#a6e3a1]🤖 ⚡ ${running_count}#[default] "
    fi
    if [[ $done_count -gt 0 ]]; then
        out="${out}#[fg=#89b4fa,bold]🤖 ✓ ${done_count}#[default] "
    fi

    if [[ -n "$out" ]]; then
        echo -n "${out}"
    fi
}

get_attention_list() {
    if [[ ! -s "$bookmarks_file" ]] || ! grep -q '[^[:space:]]' "$bookmarks_file" 2>/dev/null; then
        printf "%s│ %-16s │ %-24s │ %s\t%s\n" "📌 Empty      " "[0:0.0]" "none" "No active pins or agent alerts (Ctrl-b for all bots)" ""
        return 0
    fi

    while IFS=$'\t' read -r pane_id session_name window_index pane_index path command label kind state || [[ -n "$pane_id" ]]; do
        [[ -z "$pane_id" ]] && continue
        kind="${kind:-manual}"
        state="${state:-pinned}"

        local badge=""
        case "$kind" in
            manual)
                badge="📌 Pinned     "
                ;;
            auto)
                case "$state" in
                    waiting) badge="🤖 ⏳ Waiting " ;;
                    running) badge="🤖 ⚡ Running " ;;
                    done)    badge="🤖 ✓ Finished " ;;
                    *)       badge="🤖 $state      " ;;
                esac
                ;;
        esac

        local display_ctx="[$session_name:$window_index.$pane_index] $command"
        if [[ ${#display_ctx} -gt 16 ]]; then
            display_ctx="${display_ctx:0:13}..."
        fi

        local repo_name
        repo_name=$(basename "$path")
        if [[ ${#repo_name} -gt 24 ]]; then
            repo_name="${repo_name:0:21}..."
        fi

        local display_label="$label"
        if [[ ${#display_label} -gt 32 ]]; then
            display_label="${display_label:0:29}..."
        fi

        # Col1: Badge (pre-padded) | Col2: Context | Col3: Repo | Col4: Label \t Col5: pane_id (hidden)
        printf "%s│ %-16s │ %-24s │ %s\t%s\n" "$badge" "$display_ctx" "$repo_name" "$display_label" "$pane_id"
    done < "$bookmarks_file"
}

get_all_bots_list() {
    declare -A bm_kind bm_state bm_label
    local p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st
    while IFS=$'\t' read -r p_id s_name w_idx p_idx p_path p_cmd p_lbl p_k p_st || [[ -n "$p_id" ]]; do
        [[ -z "$p_id" ]] && continue
        bm_kind["$p_id"]="${p_k:-manual}"
        bm_state["$p_id"]="${p_st:-pinned}"
        bm_label["$p_id"]="${p_lbl}"
    done < "$bookmarks_file"

    local panes_list
    panes_list=$(tmux list-panes -a -F '#{pane_id}|#{session_name}|#{window_index}|#{pane_index}|#{pane_current_path}|#{pane_current_command}' 2>/dev/null || true)

    local count=0
    while IFS='|' read -r pane_id sess win pane path cmd; do
        [[ -z "$pane_id" ]] && continue

        local badge=""
        local label=""

        if [[ -n "${bm_kind[$pane_id]:-}" ]]; then
            if [[ "${bm_kind[$pane_id]}" == "manual" ]]; then
                badge="📌 Pinned     "
                label="${bm_label[$pane_id]}"
            else
                case "${bm_state[$pane_id]}" in
                    waiting) badge="🤖 ⏳ Waiting " ;;
                    running) badge="🤖 ⚡ Running " ;;
                    done)    badge="🤖 ✓ Finished " ;;
                    *)       badge="🤖 ${bm_state[$pane_id]}      " ;;
                esac
                label="${bm_label[$pane_id]}"
            fi
        elif [[ "$cmd" =~ $AGENT_COMMANDS_PATTERN ]]; then
            badge="🤖 💤 Idle    "
            label="idle in $(basename "$path")"
        fi

        if [[ -n "$badge" ]]; then
            count=$((count + 1))
            local display_ctx="[$sess:$win.$pane] $cmd"
            if [[ ${#display_ctx} -gt 16 ]]; then
                display_ctx="${display_ctx:0:13}..."
            fi

            local repo_name
            repo_name=$(basename "$path")
            if [[ ${#repo_name} -gt 24 ]]; then
                repo_name="${repo_name:0:21}..."
            fi

            local display_label="$label"
            if [[ ${#display_label} -gt 32 ]]; then
                display_label="${display_label:0:29}..."
            fi

            printf "%s│ %-16s │ %-24s │ %s\t%s\n" "$badge" "$display_ctx" "$repo_name" "$display_label" "$pane_id"
        fi
    done <<< "$panes_list"

    if [[ $count -eq 0 ]]; then
        printf "%s│ %-16s │ %-24s │ %s\t%s\n" "🤖 Empty      " "[0:0.0]" "none" "No agent sessions found on tmux server" ""
    fi
}

list_raw() {
    local req_mode="${1:-toggle}"
    local current_mode
    current_mode=$(tmux show-option -gv @bookmark_mode 2>/dev/null || true)
    current_mode="${current_mode:-attention}"

    local target_mode
    if [[ "$req_mode" == "toggle" ]]; then
        if [[ "$current_mode" == "attention" ]]; then
            target_mode="all"
        else
            target_mode="attention"
        fi
    else
        target_mode="$req_mode"
    fi

    tmux set-option -g @bookmark_mode "$target_mode" 2>/dev/null || true

    if [[ "$target_mode" == "all" ]]; then
        get_all_bots_list
    else
        get_attention_list
    fi
}

list_bookmarks() {
    local req_mode="${1:-auto}"
    scan_agents

    local initial_mode="attention"

    if [[ "$req_mode" == "all" ]]; then
        initial_mode="all"
    elif [[ "$req_mode" == "attention" ]]; then
        initial_mode="attention"
    elif [[ ! -s "$bookmarks_file" ]] || ! grep -q '[^[:space:]]' "$bookmarks_file" 2>/dev/null; then
        # Smart fallback: if attention list is empty, open directly in all bots view
        initial_mode="all"
    fi

    # Extra check for auto mode when attention list is empty
    if [[ "$initial_mode" == "attention" && "$req_mode" == "auto" ]]; then
        if [[ ! -s "$bookmarks_file" ]] || ! grep -q '[^[:space:]]' "$bookmarks_file" 2>/dev/null; then
            initial_mode="all"
        fi
    fi

    tmux set-option -g @bookmark_mode "$initial_mode" 2>/dev/null || true

    local formatted_list
    formatted_list=$(list_raw "$initial_mode")

    local selected
    selected=$(echo "$formatted_list" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --ansi \
        --header="📌 Bookmarks & Agents (Ctrl-b: toggle All Bots / Attention | Enter: jump | Esc: cancel)" \
        --layout=reverse \
        --border=rounded \
        --info=inline \
        --bind "ctrl-b:reload($HOME/bin/tmux-bookmark list-raw toggle)" \
        --preview 'if [[ -n "{2}" ]]; then tmux capture-pane -e -p -t {2} 2>/dev/null | awk '\''{lines[NR]=$0} END {while (NR>0 && lines[NR] ~ /^[[:space:]]*$/) NR--; for (i=1; i<=NR; i++) print lines[i]}'\'' | tail -n 30; else echo "No pane selected"; fi' \
        --preview-window='down:60%:wrap:follow' \
    )

    if [[ -n "$selected" ]]; then
        local target_pane_id
        target_pane_id=$(echo "$selected" | cut -f2)
        if [[ -n "$target_pane_id" ]] && tmux has-session -t "$target_pane_id" 2>/dev/null; then
            tmux select-pane -t "$target_pane_id"
            tmux select-window -t "$target_pane_id"
            tmux switch-client -t "$target_pane_id"
            on_focus "$target_pane_id"
        elif [[ -n "$target_pane_id" ]]; then
            tmux display-message "Target pane no longer exists."
        fi
    fi
}

case "${1:-list}" in
    add)
        shift
        with_lock add_bookmark "$*"
        ;;
    remove)
        with_lock remove_bookmark
        ;;
    is-pinned)
        is_pinned
        ;;
    scan)
        with_lock scan_agents
        ;;
    on-focus)
        shift
        with_lock on_focus "${1:-}"
        ;;
    status)
        with_lock status_summary
        ;;
    list-raw)
        shift
        list_raw "${1:-toggle}"
        ;;
    list-all)
        list_bookmarks "all"
        ;;
    list)
        shift || true
        list_bookmarks "${1:-auto}"
        ;;
    *)
        echo "Usage: $0 {add|remove|is-pinned|scan|on-focus|status|list-raw|list-all|list}"
        exit 1
        ;;
esac
