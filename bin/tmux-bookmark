#!/usr/bin/env bash

bookmarks_file="$HOME/.tmux-bookmarks"
touch "$bookmarks_file"

prune_bookmarks() {
    local temp_file
    temp_file=$(mktemp)
    while IFS=$'\t' read -r pane_id session_name window_index pane_index path command label; do
        if [[ -n "$pane_id" ]] && tmux has-session -t "$pane_id" 2>/dev/null; then
            echo -e "${pane_id}\t${session_name}\t${window_index}\t${pane_index}\t${path}\t${command}\t${label}" >> "$temp_file"
        fi
    done < "$bookmarks_file"
    mv "$temp_file" "$bookmarks_file"
}

add_bookmark() {
    local label="$1"
    
    # Prune dead ones first
    prune_bookmarks

    # Get current pane info
    local info
    info=$(tmux display-message -p '#{pane_id}	#{session_name}	#{window_index}	#{pane_index}	#{pane_current_path}	#{pane_current_command}')
    IFS=$'\t' read -r pane_id session_name window_index pane_index path command <<< "$info"

    # If label is empty, make a default one
    if [[ -z "$label" ]]; then
        label="$command in $(basename "$path")"
    fi

    if grep -q "^${pane_id}" "$bookmarks_file"; then
        # Already exists, so unpin it
        grep -v "^${pane_id}" "$bookmarks_file" > "${bookmarks_file}.tmp"
        mv "${bookmarks_file}.tmp" "$bookmarks_file"
        tmux display-message "📌 Unpinned: $label"
    else
        # Add to bookmarks
        echo -e "${pane_id}\t${session_name}\t${window_index}\t${pane_index}\t${path}\t${command}\t${label}" >> "$bookmarks_file"
        tmux display-message "📌 Pinned: $label"
    fi
}

list_bookmarks() {
    # Prune dead ones first to ensure list is fresh
    prune_bookmarks

    if [[ ! -s "$bookmarks_file" ]]; then
        tmux display-message "No active pinned panes."
        exit 0
    fi

    # Read file and format nicely for a TUI look
    local formatted_list
    formatted_list=$(
        while IFS=$'\t' read -r pane_id session_name window_index pane_index path command label; do
            local display_label="$label"
            if [[ ${#display_label} -gt 25 ]]; then
                display_label="${display_label:0:22}..."
            fi
            
            local display_ctx="[$session_name:$window_index.$pane_index] $command"
            if [[ ${#display_ctx} -gt 35 ]]; then
                display_ctx="${display_ctx:0:32}..."
            fi

            # Format: Col1 │ Col2 │ Col3 \t pane_id (hidden in fzf display)
            printf "%-25s │ %-35s │ %s\t%s\n" "$display_label" "$display_ctx" "$path" "$pane_id"
        done < "$bookmarks_file"
    )

    local selected
    selected=$(echo "$formatted_list" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --header="📌 Jump to pinned pane (Enter to jump, Ctrl-C to cancel):" \
        --layout=reverse \
        --border=rounded \
        --info=inline
    )

    if [[ -n "$selected" ]]; then
        local target_pane_id
        target_pane_id=$(echo "$selected" | cut -f2)
        if tmux has-session -t "$target_pane_id" 2>/dev/null; then
            tmux select-pane -t "$target_pane_id"
            tmux select-window -t "$target_pane_id"
            tmux switch-client -t "$target_pane_id"
        else
            tmux display-message "Target pane no longer exists."
        fi
    fi
}

case "$1" in
    add)
        shift
        add_bookmark "$*"
        ;;
    list)
        list_bookmarks
        ;;
    *)
        echo "Usage: $0 {add|list}"
        exit 1
        ;;
esac
