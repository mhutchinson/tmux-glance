#!/usr/bin/env bash
# tmux-glance v0.7 — thin bash dispatcher
# All stateful engine logic has moved to glance-engine (Go binary).
# This script handles:
#   - fzf popup assembly (list-bookmarks / list-all / list-sessions / list-history)
#   - live pane preview loop (preview)
#   - interactive pin keyread (pin-interactive)
#   - cheat sheet (cheat-sheet)
#   - SELF_BIN resolution for fzf --bind reload callbacks
# Everything else is delegated to glance-engine.
set -euo pipefail

export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

# --- Self-binary resolution for fzf callbacks ---
SELF_BIN="${BASH_SOURCE[0]}"
if [[ -f "$SELF_BIN" ]]; then
    SELF_BIN="$(cd "$(dirname "$SELF_BIN")" && pwd)/$(basename "$SELF_BIN")"
elif [[ ! -x "$SELF_BIN" ]]; then
    SELF_BIN=$(command -v tmux-glance || echo "$0")
fi
export TMUX_GLANCE_BIN="$SELF_BIN"

# --- Locate glance-engine binary ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE=""
for candidate in \
    "${TMUX_GLANCE_ENGINE:-}" \
    "$SCRIPT_DIR/glance-engine" \
    "$SCRIPT_DIR/../libexec/glance-engine" \
    "$(command -v glance-engine 2>/dev/null || true)"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        ENGINE="$candidate"
        break
    fi
done

if [[ -z "$ENGINE" ]]; then
    echo "glance-engine not found. Run 'go build -o bin/glance-engine ./cmd/glance-engine' first." >&2
    exit 1
fi

# --- Pure-bash functions (no state, no engine needed) ---

preview_pane() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo "No target selected"
        return 0
    fi
    trap 'exit 0' INT TERM HUP
    local prev_hash=""
    while true; do
        if ! tmux has-session -t "$target" 2>/dev/null; then
            printf '\033[2J\033[H'
            echo "Target $target closed or inactive."
            return 0
        fi
        local content
        content=$(tmux capture-pane -e -p -t "$target" 2>/dev/null \
            | awk '{lines[NR]=$0} END {while (NR>0 && lines[NR] ~ /^[[:space:]]*$/) NR--; for (i=1; i<=NR; i++) print lines[i]}' \
            | tail -n 35)
        local curr_hash
        curr_hash=$(echo "$content" | (md5 -q 2>/dev/null || md5sum 2>/dev/null | cut -d' ' -f1 || cksum | cut -d' ' -f1))
        if [[ "$curr_hash" != "$prev_hash" ]]; then
            printf '\033[2J\033[H%s\n' "$content"
            prev_hash="$curr_hash"
        fi
        sleep 0.5
    done
}

# shellcheck disable=SC2120
pin_interactive() {
    local target="${1:-}"
    local target_session=""
    if [[ -z "$target" ]]; then
        target_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    elif [[ "$target" =~ ^% ]]; then
        target_session=$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || true)
    else
        target_session="$target"
    fi
    [[ -z "$target_session" ]] && return 0

    local current_slot=""
    current_slot=$("$ENGINE" query-slot "$target_session" 2>/dev/null || true)

    local prompt_msg="📌 Pin [${target_session}] to Harpoon slot (h/j/k/l, Space/Del to unpin, Esc to cancel): "
    if [[ -n "$current_slot" ]]; then
        prompt_msg="📌 [${target_session}] currently in [${current_slot}] (h/j/k/l, Space/Del to unpin, Esc to cancel): "
    fi

    printf "\n\033[1;36m%s\033[0m" "$prompt_msg"
    local key=""
    IFS= read -r -s -n 1 key || true

    case "$key" in
        [hHjJkKlL1-9])
            "$ENGINE" assign-slot "$key" "$target_session"
            ;;
        ' '|$'\177'|$'\b')
            "$ENGINE" unassign-slot "$target_session"
            ;;
        *)
            ;;
    esac
}

cheat_sheet() {
    printf '\033[2J\033[H'
    cat << 'EOF'

  ┌─────────────────────────────────────────────────────────────┐
  │                   tmux-glance Viewfinder                    │
  ├─────────────────────────────────────────────────────────────┤
  │ View Controls:                                              │
  │   Ctrl-g       Toggle Global Panes <-> Bots & Views         │
  │   Ctrl-s       Switch to Sessionizer (Workspaces)           │
  │   Ctrl-h       Switch to Jump History Timeline              │
  │                                                             │
  │ History Actions:                                            │
  │   Ctrl-x       Clear jump history stack                     │
  │                                                             │
  │ Session Actions:                                            │
  │   Ctrl-p       Pin / Unpin highlighted session (h/j/k/l)    │
  │                                                             │
  │ General:                                                    │
  │   Enter        Jump to highlighted pane / session           │
  │   Ctrl-/ / F1  Toggle this help cheat sheet                 │
  │   Esc          Close popup / cancel                         │
  └─────────────────────────────────────────────────────────────┘

  Press any key to return...
EOF
    IFS= read -r -s -n 1 _ || true
}

# --- fzf popup launcher ---
# shellcheck disable=SC2016
list_bookmarks() {
    local req_mode="${1:-auto}"
    local source_pane="${2:-}"
    if [[ -z "$source_pane" ]]; then
        source_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)
    fi

    local initial_mode="bots"
    case "$req_mode" in
        all|global) initial_mode="all" ;;
        sessions)   initial_mode="sessions" ;;
        history)    initial_mode="history" ;;
        bots)       initial_mode="bots" ;;
        attention)  initial_mode="attention" ;;
        auto)
            # Default to all-panes if state file is empty (nothing tracked yet).
            if ! "$ENGINE" list-raw current 2>/dev/null | grep -q '[^[:space:]]'; then
                initial_mode="all"
            fi
            ;;
    esac

    tmux set-option -g @glance_mode "$initial_mode" 2>/dev/null || true
    local header
    header=$("$ENGINE" mode-header "$initial_mode" 2>/dev/null || echo "👁️ tmux-glance")

    local fzf_extra_args=()
    if [[ -n "${TMUX_GLANCE_FZF_FILTER:-}" ]]; then
        fzf_extra_args+=(--filter="$TMUX_GLANCE_FZF_FILTER")
    else
        fzf_extra_args+=(--bind "start:reload($ENGINE scan force 2>/dev/null; $ENGINE list-raw current 2>/dev/null)+pos(1)")
    fi
    if [[ "$initial_mode" == "history" ]]; then
        local init_pos
        init_pos=$("$ENGINE" history-cursor-pos 2>/dev/null || echo 1)
        fzf_extra_args+=(--bind "load:pos($init_pos)")
    fi

    local selected
    selected=$("$ENGINE" list-raw "$initial_mode" | fzf \
        ${fzf_extra_args[@]+"${fzf_extra_args[@]}"} \
        --delimiter=$'\t' \
        --with-nth=1 \
        --ansi \
        --header="$header" \
        --layout=reverse \
        --border=rounded \
        --info=inline \
        --bind "ctrl-g:transform($ENGINE eval-mode-action toggle-global)" \
        --bind "ctrl-s:transform($ENGINE eval-mode-action sessions)" \
        --bind "ctrl-h:transform($ENGINE eval-mode-action history)" \
        --bind "ctrl-x:execute($ENGINE clear-history)+reload($ENGINE list-raw current)+wait+pos(1)" \
        --bind "ctrl-p:execute($SELF_BIN pin-interactive {2})+reload($ENGINE list-raw current)" \
        --bind "ctrl-/:execute($SELF_BIN cheat-sheet)" \
        --bind "f1:execute($SELF_BIN cheat-sheet)" \
        --preview "\"$SELF_BIN\" preview {2}" \
        --preview-window='down:60%:wrap:follow' \
    ) || true

    if [[ -n "${TMUX_GLANCE_FZF_FILTER:-}" ]]; then
        # When TMUX_GLANCE_FZF_FILTER is set, fzf runs non-interactively with --filter (e.g. during test suites).
        # Never execute client switching or pane jumps during non-interactive filter checks.
        return 0
    fi

    if [[ -n "$selected" ]]; then
        if [[ "$selected" =~ "📍 CUR" ]]; then
            return 0
        fi

        local target="${selected##*$'\t'}"
        if [[ -n "$target" && "$target" == "$source_pane" ]]; then
            return 0
        fi
        if [[ -n "$target" ]] && tmux has-session -t "$target" 2>/dev/null; then
            local active_mode
            active_mode=$(tmux show-option -gqv @glance_mode 2>/dev/null || true)
            local dir=""
            if [[ "$selected" =~ "FWD" ]]; then
                dir="fwd"
            elif [[ "$selected" =~ "BACK" ]]; then
                dir="back"
            fi

            if [[ "$target" =~ ^% ]]; then
                if [[ "$active_mode" == "history" ]]; then
                    "$ENGINE" shift-to "$source_pane" "$target" "$dir" 2>/dev/null || true
                else
                    "$ENGINE" record-jump "$source_pane" "$target" 2>/dev/null || true
                fi
                tmux select-pane -t "$target" \; select-window -t "$target" \; switch-client -t "$target" \; display-popup -C 2>/dev/null || true
            else
                local sess_active_pane
                sess_active_pane=$(tmux display-message -p -t "$target" '#{pane_id}' 2>/dev/null || true)
                if [[ -n "$source_pane" && -n "$sess_active_pane" ]]; then
                    if [[ "$active_mode" == "history" ]]; then
                        "$ENGINE" shift-to "$source_pane" "$sess_active_pane" "$dir" 2>/dev/null || true
                    else
                        "$ENGINE" record-jump "$source_pane" "$sess_active_pane" 2>/dev/null || true
                    fi
                fi
                tmux switch-client -t "$target" \; display-popup -C 2>/dev/null || true
            fi
        elif [[ -n "$target" ]]; then
            tmux display-message "Target pane or session no longer exists."
        fi
    fi
}

# --- Command dispatch ---
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    case "${1:-list}" in
        # Pure bash commands (no engine needed)
        preview)
            shift
            preview_pane "${1:-}"
            ;;
        pin-interactive)
            shift
            pin_interactive "${1:-}"
            ;;
        cheat-sheet|help-modal)
            cheat_sheet
            ;;
        # fzf popup launchers (bash + engine for data)
        list)
            shift || true
            list_bookmarks "${1:-bots}" "${2:-}"
            ;;
        list-all|list-global)
            shift || true
            list_bookmarks "all" "${1:-}"
            ;;
        list-bots)
            shift || true
            list_bookmarks "bots" "${1:-}"
            ;;
        list-sessions|sessions)
            shift || true
            list_bookmarks "sessions" "${1:-}"
            ;;
        list-history|history)
            shift || true
            list_bookmarks "history" "${1:-}"
            ;;
        # Everything else → glance-engine
        *)
            exec "$ENGINE" "$@"
            ;;
    esac
fi
